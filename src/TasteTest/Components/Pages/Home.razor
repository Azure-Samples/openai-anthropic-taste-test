@page "/"
@using System.Diagnostics
@implements IDisposable
@inject TasteTestSession Session
@inject ILogger<Home> Logger

<PageTitle>Blind A/B Model Taste Test</PageTitle>

<main class="taste-shell">
    <header class="hero">
        <div>
            <p class="eyebrow">MICROSOFT FOUNDRY</p>
            <h1>One prompt. Two perspectives.</h1>
            <p class="hero-copy">One <code>IChatClient</code>. Pick the answer, then discover the model.</p>
        </div>
        <div class="blind-badge" role="status">
            <span class="blind-dot"></span>
            @(Session.Revealed ? $"Lane {Session.Winner!.Label} selected" : "Identities hidden until you vote")
        </div>
    </header>

    @if (Session.UseSampleResponses)
    {
        <div class="sample-notice" role="status">
            UI preview: canned answers and estimated token counts, not live model measurements.
        </div>
    }

    <section class="composer-section" aria-label="Prompt composer">
        @if (ErrorMessage is not null)
        {
            <div class="form-error" role="alert">@ErrorMessage</div>
        }
        <form class="composer" aria-busy="@(IsSubmitting ? "true" : "false")" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <label for="taste-prompt">
                @(Session.Revealed ? "Continue with your winner" : "Ask both models the same question")
            </label>
            <textarea id="taste-prompt"
                      @bind="Prompt"
                      @bind:event="oninput"
                      maxlength="@Session.MaxPromptCharacters"
                      rows="2"
                      disabled="@IsSubmitting"
                      placeholder="Ask for an explanation, a judgment call, or a rewrite..."></textarea>
            <div class="composer-actions">
                <span>@Prompt.Length / @Session.MaxPromptCharacters</span>
                @if (IsSubmitting)
                {
                    <button type="button" class="button-secondary" disabled="@_cancelRequested" @onclick="Cancel">
                        @(_cancelRequested ? "Canceling..." : "Cancel")
                    </button>
                }
                @if (Session.HasTranscript)
                {
                    <button type="button" class="button-secondary" disabled="@IsSubmitting" @onclick="NewTasteTest">New taste test</button>
                }
                <button type="submit" class="button-primary" disabled="@(IsSubmitting || string.IsNullOrWhiteSpace(Prompt))">
                    @(IsSubmitting ? "Generating..." : Session.Revealed ? "Ask winner" : "Compare answers")
                </button>
            </div>
        </form>
        @if (IsSubmitting)
        {
            <p class="request-status" role="status">
                @(_cancelRequested
                    ? "Canceling this request. Completed conversation history will be kept."
                    : Session.Revealed
                        ? "Your winner is answering. You can cancel at any time."
                        : "Request sent to both lanes. Models may think before text appears. You can cancel at any time.")
            </p>
        }
    </section>

    @if (!Session.HasTranscript)
    {
        <section class="seed-section" aria-labelledby="seed-heading">
            <div class="section-heading">
                <h2 id="seed-heading">Need a starting point?</h2>
            </div>
            <p class="request-status">The support-plan question uses one shared, read-only catalog tool. Prices and support targets are fictional.</p>
            <div class="seed-grid">
                @foreach (var seed in Session.SeedPrompts)
                {
                    <button type="button" class="seed-card" disabled="@IsSubmitting" @onclick="() => SelectPrompt(seed)">
                        @seed
                    </button>
                }
            </div>
        </section>
    }

    @if (Session.Revealed)
    {
        <section class="reveal-panel" aria-labelledby="reveal-heading">
            <div class="section-heading">
                <span>THE REVEAL</span>
                <h2 id="reveal-heading">Your preference. Their identity.</h2>
            </div>
            <div class="identity-grid">
                @foreach (var lane in Session.Lanes)
                {
                    var identity = Session.GetIdentity(lane);
                    var isWinner = ReferenceEquals(lane, Session.Winner);
                    <article @key="lane"
                             class="identity-card @(isWinner ? "identity-winner" : null)"
                             data-provider="@identity.Provider">
                        <div class="identity-lane">@lane.Label</div>
                        <div class="identity-body">
                            <p>@identity.Provider · @identity.Protocol</p>
                            <h3>@identity.ModelId</h3>
                            <span>@identity.Sdk</span>
                        </div>
                        @if (isWinner)
                        {
                            <strong>WINNER</strong>
                        }
                    </article>
                }
            </div>
            <div class="construction-diff">
                <div class="construction-intro">
                    <p class="eyebrow">TWO SDKS. ONE CONTRACT.</p>
                    <h3>Both return <code>IChatClient</code></h3>
                    <p class="construction-note">Different vendors, different wire protocols, identical call site.</p>
                </div>
                <div class="construction-rows">
                    @foreach (var provider in new[] { ProviderKind.OpenAI, ProviderKind.Anthropic })
                    {
                        var identity = Session.GetIdentity(provider);
                        <div @key="provider" class="construction-row" data-provider="@identity.Provider">
                            <span class="construction-sdk">@identity.Sdk</span>
                            <code>@ConstructionSnippet(provider, identity.ModelId)</code>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="lane-grid @(Session.Revealed ? "lane-grid-revealed" : null)" aria-label="Model responses">
        @foreach (var lane in Session.VisibleLanes)
        {
            <article @key="lane" class="lane-card">
                <header class="lane-header">
                    <div class="lane-letter">@lane.Label</div>
                    <div>
                        <p class="lane-kicker">LANE @lane.Label</p>
                        <h2>@(Session.Revealed ? "Your winner" : "Identity hidden")</h2>
                    </div>
                    <span class="stream-status" role="status">
                        @if (lane.IsStreaming)
                        {
                            <span></span>
                            <text>Generating</text>
                        }
                        else if (lane.LatestTurn is { IsComplete: true })
                        {
                            <text>Answer ready</text>
                        }
                        else if (lane.HasError)
                        {
                            <text>Needs retry</text>
                        }
                    </span>
                </header>

                <div class="lane-transcript" aria-live="polite" aria-busy="@(lane.IsStreaming ? "true" : "false")" tabindex="0" aria-label="@($"Lane {lane.Label} conversation")">
                    @if (lane.Turns.Count == 0)
                    {
                        <div class="empty-lane">
                            <span>@lane.Label</span>
                            <p>Same prompt. Independent answer.</p>
                        </div>
                    }

                    @foreach (var turn in lane.Turns)
                    {
                        <div @key="turn" class="turn">
                            <div class="turn-label">You</div>
                            <p class="turn-prompt">@turn.Prompt</p>
                            <div class="turn-label">Answer</div>
                            @if (turn.IsStreaming && !turn.HasResponse)
                            {
                                <div class="thinking">
                                    <span></span><span></span><span></span>
                                    <em>Thinking</em>
                                </div>
                            }
                            else
                            {
                                <ModelAnswer Text="@turn.Response" IsStreaming="@turn.IsStreaming" />
                            }
                            @if (turn.Duration is not null || turn.TimeToFirstToken is not null)
                            {
                                <div class="turn-metrics" aria-label="@($"Lane {lane.Label} response metrics")">
                                    @if (turn.TimeToFirstToken is { } firstToken)
                                    {
                                        <span><b>@Format(firstToken)</b> to first text</span>
                                    }
                                    @if (!turn.IsStreaming && turn.Duration is { } duration)
                                    {
                                        <span><b>@Format(duration)</b> total</span>
                                    }
                                    @if (turn.Usage is { OutputTokenCount: { } output })
                                    {
                                        <span><b>@output.ToString("N0")</b> output tokens</span>
                                    }
                                    @if (turn.Usage is { InputTokenCount: { } input })
                                    {
                                        <span><b>@input.ToString("N0")</b> input</span>
                                    }
                                    <span class="catalog-lookups"><b>@turn.CatalogLookups</b> catalog @(turn.CatalogLookups == 1 ? "lookup" : "lookups")</span>
                                    @if (turn.CatalogLookupErrors > 0)
                                    {
                                        <span>@turn.CatalogLookupErrors catalog @(turn.CatalogLookupErrors == 1 ? "error" : "errors")</span>
                                    }
                                    @if (Session.UseSampleResponses)
                                    {
                                        <span>Estimated preview usage</span>
                                    }
                                </div>
                            }
                            @if (turn.Error is not null)
                            {
                                <div class="lane-error" role="alert">@turn.Error</div>
                            }
                            @if (!IsSubmitting && !turn.IncludedInHistory)
                            {
                                <p class="turn-notice">
                                    @(turn.IsComplete
                                        ? "Answer complete. Not added to history because the comparison did not finish successfully."
                                        : "Unfinished answer. Not used as context for your next question.")
                                </p>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </section>

    @if (Session.HasTranscript && !Session.Revealed)
    {
        <section class="vote-panel" aria-labelledby="vote-heading">
            <div>
                <p class="eyebrow">TRUST YOUR TASTE</p>
                <h2 id="vote-heading">@(Session.CanPick ? "Which answer would you ship?" : IsSubmitting ? "Waiting for both answers" : "This comparison needs a retry")</h2>
                @if (!Session.CanPick && !IsSubmitting)
                {
                    <p>Voting needs two completed answers. Retry the same prompt in both lanes, or edit it above.</p>
                }
            </div>
            <div class="vote-actions">
                @foreach (var lane in Session.Lanes)
                {
                    <button type="button" class="vote-button" disabled="@(!Session.CanPick || IsSubmitting)" @onclick="() => Pick(lane)">Pick @lane.Label</button>
                }
                @if (Session.CanRetry && !IsSubmitting)
                {
                    <button type="button" class="button-primary" @onclick="RetryAsync">Retry comparison</button>
                }
            </div>
        </section>
    }

    @if (Session.Revealed && Session.CanRetry && !IsSubmitting)
    {
        <div class="retry-panel" role="status">
            <span>Your previous conversation is safe. This answer did not finish.</span>
            <button type="button" class="button-primary" @onclick="RetryAsync">Retry answer</button>
        </div>
    }

    @if (Session.Revealed)
    {
        <footer class="model-footer">
            @foreach (var lane in Session.Lanes)
            {
                <span>Lane @lane.Label · @Session.GetIdentity(lane).ModelId</span>
            }
        </footer>
    }
</main>

@code {
    private static readonly TimeSpan RenderInterval = TimeSpan.FromMilliseconds(100);
    private CancellationTokenSource? _requestCancellation;
    private long _lastRenderTimestamp;
    private bool _disposed;
    private bool _cancelRequested;
    private bool IsSubmitting => _requestCancellation is not null || Session.IsBusy;
    private string Prompt { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }

    private void SelectPrompt(string prompt)
    {
        Prompt = prompt;
        ErrorMessage = null;
    }

    private async Task SubmitAsync()
    {
        if (IsSubmitting)
        {
            TasteTestLog.DuplicateSubmit(Logger);
            return;
        }

        var submittedPrompt = Prompt;
        ErrorMessage = null;
        using var cancellation = new CancellationTokenSource();
        _requestCancellation = cancellation;
        _cancelRequested = false;

        try
        {
            Prompt = string.Empty;
            // Paint the busy state before any SDK or credential initialization can run.
            StateHasChanged();
            await Task.Yield();
            await Session.SendAsync(submittedPrompt, RequestRenderAsync, cancellation.Token);
            if (Session.VisibleLanes.Any(lane => lane.HasError))
            {
                Prompt = submittedPrompt;
            }
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            Prompt = submittedPrompt;
            ErrorMessage = "The request could not be completed. Check the server logs and try again.";
            TasteTestLog.RequestFailed(Logger, exception);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            Prompt = submittedPrompt;
            ErrorMessage = "Canceled. You can retry; this attempt was not added to conversation history.";
        }
        finally
        {
            _requestCancellation = null;
            _cancelRequested = false;
            await RequestRenderAsync(true);
        }
    }

    private Task RequestRenderAsync(bool force)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        var now = Stopwatch.GetTimestamp();
        if (force)
        {
            Interlocked.Exchange(ref _lastRenderTimestamp, now);
        }
        else
        {
            var previous = Interlocked.Read(ref _lastRenderTimestamp);
            if (Stopwatch.GetElapsedTime(previous, now) < RenderInterval ||
                Interlocked.CompareExchange(ref _lastRenderTimestamp, now, previous) != previous)
            {
                return Task.CompletedTask;
            }
        }

        return InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void Pick(TasteTestLane lane)
    {
        Session.PickWinner(lane);
        ErrorMessage = null;
    }

    private Task RetryAsync()
    {
        if (IsSubmitting)
        {
            TasteTestLog.DuplicateSubmit(Logger);
            return Task.CompletedTask;
        }

        if (!Session.CanRetry)
        {
            ErrorMessage = "There is no failed answer to retry. Enter a new question instead.";
            return Task.CompletedTask;
        }

        Prompt = Session.VisibleLanes[0].LatestTurn!.Prompt;
        return SubmitAsync();
    }

    private void NewTasteTest()
    {
        Session.Reset();
        Prompt = string.Empty;
        ErrorMessage = null;
    }

    private void Cancel()
    {
        _cancelRequested = true;
        _requestCancellation?.Cancel();
    }

    private static string Format(TimeSpan value) =>
        value.TotalSeconds < 1
            ? $"{value.TotalMilliseconds:N0}ms"
            : $"{value.TotalSeconds:N1}s";

    private static string ConstructionSnippet(ProviderKind provider, string modelId) => provider switch
    {
        ProviderKind.OpenAI => $"""new OpenAIClient(...).GetResponsesClient().AsIChatClient("{modelId}")""",
        ProviderKind.Anthropic => $"""new AnthropicFoundryClient(...).AsIChatClient("{modelId}")""",
        _ => throw ModelCatalog.UnknownProvider(provider)
    };

    public void Dispose()
    {
        _disposed = true;
        // SubmitAsync owns disposal; cancellation must finish before the source is disposed.
        _requestCancellation?.Cancel();
    }
}
