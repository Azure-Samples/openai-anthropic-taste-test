<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <NoWarn>$(NoWarn);MEAI001;OPENAI001</NoWarn>
    <UserSecretsId>f2aa97a4-63b1-4bc6-b225-510b6150d580</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Anthropic.Foundry" Version="1.0.0" />
    <PackageReference Include="Azure.Core" Version="1.64.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="System.ClientModel" Version="1.16.0" />
  </ItemGroup>

  <!-- Pin credential/transport transitive dependencies to current supported patches. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageReference Include="System.Memory.Data" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
