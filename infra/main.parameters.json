{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID=}"
    },
    "claudeModelName": {
      "value": "${CLAUDE_MODEL_NAME=claude-opus-5}"
    },
    "claudeModelVersion": {
      "value": "${CLAUDE_MODEL_VERSION=2}"
    },
    "claudeModelCapacity": {
      "value": "${CLAUDE_MODEL_CAPACITY=25}"
    },
    "aoaiModelName": {
      "value": "${AOAI_MODEL_NAME=gpt-5.6-sol}"
    },
    "aoaiModelVersion": {
      "value": "${AOAI_MODEL_VERSION=2026-07-09}"
    },
    "aoaiModelCapacity": {
      "value": "${AOAI_MODEL_CAPACITY=10}"
    },
    "claudeOrganizationName": {
      "value": "${CLAUDE_ORGANIZATION_NAME}"
    },
    "claudeCountryCode": {
      "value": "${CLAUDE_COUNTRY_CODE=US}"
    },
    "claudeIndustry": {
      "value": "${CLAUDE_INDUSTRY=technology}"
    },
    "maxOutputTokens": {
      "value": "${TASTE_TEST_MAX_OUTPUT_TOKENS=900}"
    },
    "containerMinReplicas": {
      "value": "${CONTAINER_MIN_REPLICAS=1}"
    },
    "hostingMode": {
      "value": "${HOSTING_MODE=containerapp}"
    },
    "assignInferenceRoleToDeployer": {
      "value": "${ASSIGN_INFERENCE_ROLE_TO_DEPLOYER=true}"
    }
  }
}
